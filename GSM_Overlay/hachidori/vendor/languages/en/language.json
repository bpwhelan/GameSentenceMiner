{
  "schema": 1,
  "code": "en",
  "iso639_3": "eng",
  "name": "English",
  "nativeName": "English",
  "bcp47": "en",
  "scripts": ["Latn"],
  "direction": "ltr",
  "classes": {
    "letter": "[A-Za-z\\u00C0-\\u00D6\\u00D8-\\u00F6\\u00F8-\\u024F\\u1E00-\\u1EFF\\uFB00-\\uFB06]",
    "word": "[{letter}\\p{M}\\p{Nd}]"
  },
  "text": {
    "pattern": "{letter}",
    "scanStart": "word",
    "segmentation": "spaces",
    "wordCharacters": "{word}",
    "wordInternal": "[\\u00AD]",
    "sentence": {
      "terminators": [".", "!", "?", "…"],
      "quotePairs": [["“", "”"], ["\"", "\""], ["(", ")"]]
    },
    "highlightBreaks": null,
    "lineJoiner": " "
  },
  "lookup": {
    "searchResolution": "word",
    "preprocessors": [
      {
        "id": "decapitalize",
        "name": "Decapitalize text",
        "variants": [[{"case": "lower"}]]
      },
      {
        "id": "capitalizeFirstLetter",
        "name": "Capitalize first letter",
        "variants": [[{"case": "upperFirst"}]]
      },
      {
        "id": "normalizeApostrophes",
        "name": "Typographic apostrophes as '",
        "variants": [[{"map": {"’": "'", "‘": "'", "ʼ": "'", "＇": "'"}}]]
      },
      {
        "id": "normalizeHyphens",
        "name": "Unicode hyphens as -",
        "variants": [[{"map": {"‐": "-", "‑": "-"}}]]
      },
      {
        "id": "removeSoftHyphens",
        "name": "Remove soft hyphens",
        "keepInput": false,
        "variants": [[{"strip": "[\\u00AD]"}]]
      },
      {
        "id": "removeDiacritics",
        "name": "Remove diacritics",
        "variants": [[{"normalize": "NFD"}, {"strip": "[\\u0300-\\u036F]"}, {"normalize": "NFC"}]]
      },
      {
        "id": "expandLigatures",
        "name": "Expand ligatures",
        "variants": [[{"map": {"æ": "ae", "Æ": "Ae", "œ": "oe", "Œ": "Oe"}}, {"normalize": "NFKC", "within": "[\\uFB00-\\uFB06]"}]]
      }
    ],
    "postprocessors": [],
    "readingNormalizer": null,
    "transforms": "transforms.json",
    "traceSelection": "shortest",
    "formOf": "follow",
    "functionWords": [],
    "variantPasses": []
  },
  "capabilities": {
    "readings": "none",
    "ruby": null,
    "pitchAccent": false,
    "characterView": null,
    "wordHighlighting": true
  },
  "presentation": {
    "typography": {
      "fontFamily": null,
      "wordBreak": null,
      "lineBreak": null,
      "joinedScript": false
    },
    "labels": {},
    "displayTransforms": {}
  },
  "settings": [
    {
      "id": "archaicForms",
      "type": "boolean",
      "default": false,
      "label": "Archaic verb forms",
      "description": "Also read Early Modern English verb endings, as in thou walkest, he walketh, thou art and he hath (the King James Bible, Shakespeare). Off by default, because -est and -eth also end ordinary words.",
      "group": "lookup",
      "effect": {"transforms": ["archaicSecondPerson", "archaicThirdPerson"]}
    }
  ],
