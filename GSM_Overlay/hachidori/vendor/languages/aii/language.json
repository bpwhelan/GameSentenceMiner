    "yomitanDiacritic": "[\\u0303\\u0304\\u0307\\u0308\\u0323\\u032E\\u0330\\u0331\\u0730-\\u074A]",
    "joiner": "[\\u00AD\\u0640\\u200C\\u200D\\u2060\\uFEFF]",
