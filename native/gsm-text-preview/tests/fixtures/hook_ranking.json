  {
    "name": "test_combines_control_character_cleanup_and_language_filtering_for_bilingual_dialogue",
    "snapshot": {
      "hooks": [
        {
          "id": "Ages3ResT",
          "samples": [
            "【武】「…\u0003…\u0003…\u0003うそ〜ん」\u0003\n【Takeru】「…No frickin' way…」\u0003"
          ]
        }
      ],
      "selectedHookId": null,
      "processorOverrides": null
    },
    "blocks": [
      "武",
      "⋯ 『うそ～ん！』"
    ],
    "settings": {
      "remove_control_chars": false
    },
    "language": "ja",
    "expected": [
      {
        "hookId": "Ages3ResT",
        "tier": "filtered",
        "processorOverrides": {
          "remove_control_chars": true,
          "language_filter": true
        },
        "sample": "【武】「…\u0003…\u0003…\u0003うそ〜ん」\u0003\n【Takeru】「…No frickin' way…」\u0003",
        "output": "【武】「………うそ〜ん」",
        "ocrText": "⋯ 『うそ～ん！』",
        "changes": {
          "remove_control_chars": true,
          "language_filter": true
        }
      }
    ]
  },
