{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GSM",
  "version": "2026.11.0",
  "identifier": "com.beangate.gamesentenceminer",
  "build": {
    "frontendDist": "host"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "desktop",
          "windows": [
            "gsm-*",
            "obs-scene-conflict"
          ],
          "permissions": [
            "notification:allow-is-permission-granted",
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../assets/gsm.ico",
      "../assets/gsm.png"
    ]
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
